{
  "name": "@monotykamary/pi-better-grok",
  "version": "0.1.2",
  "description": "Improve Grok/xAI in pi with fast mode, subscription usage stats, footer polish, and settings — mirroring pi-better-openai.",
  "keywords": [
    "footer",
    "grok",
    "pi",
    "pi-extension",
    "pi-package",
    "supergrok",
    "usage",
    "xai"
  ],
  "homepage": "https://github.com/monotykamary/pi-better-grok#readme",
  "bugs": {
    "url": "https://github.com/monotykamary/pi-better-grok/issues"
  },
  "license": "MIT",
  "author": "monotykamary",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/pi-better-grok.git"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings index.ts src/*.ts tests/*.ts",
    "lint:fix": "oxlint --fix index.ts src/*.ts tests/*.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "~22.19.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "undici": "8.10.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
